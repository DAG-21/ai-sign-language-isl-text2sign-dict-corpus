# Google Gemini API key for the online ISL translation route (app/api/translate-isl).
# Get one at https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key. Without it, the app still
# works — it falls back to the offline rule-based translator (textToGloss).
GEMINI_API_KEY=

# Phase 1 (the Python pipeline in the signLanguage folder) is reached over HTTP on this machine only.
# scripts/dev-all.ps1 starts it and sets this for you; set it yourself only if Phase 1 runs on another loopback port.
# Phase 1 keeps its own GROQ_API_KEY in its own .env: this app never reads or needs that key.
PHASE1_URL=http://127.0.0.1:8765
